<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  
  <Type Name="string">
    <DisplayString>{data,[count]} [size={count}]</DisplayString>
    
    <Expand>
      <Item Name="[size]">count</Item>
      <Item Name="[string]">data,[count]s8</Item>
    </Expand>
  </Type>
  
  <Type Name="slice&lt;*&gt;">
    <DisplayString>{{ size={count} }}</DisplayString>
    
    <Expand>
      <Item Name="[size]">count</Item>
      
      <ArrayItems>
        <Size>count</Size>
        <ValuePointer>data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="bump_array&lt;*&gt;">
    <DisplayString>{{ size={count} }}</DisplayString>
    
    <Expand>
      <Item Name="[size]">count</Item>
      <Item Name="[capacity]">capacity</Item>
      
      <ArrayItems>
        <Size>count</Size>
        <ValuePointer>data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="dynamic_array&lt;*&gt;">
    <DisplayString>{{ size={count} }}</DisplayString>

    <Expand>
      <Item Name="[size]">count</Item>
      <Item Name="[capacity]">capacity</Item>

      <ArrayItems>
        <Size>count</Size>
        <ValuePointer>data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="static_bump_array&lt;*,*&gt;">
    <DisplayString>{{ size={count} }}</DisplayString>
    
    <Expand>
      <Item Name="[size]">count</Item>
      <Item Name="[capacity]">$T2</Item>
      
      <ArrayItems>
        <Size>count</Size>
        <ValuePointer>data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="list&lt;*&gt;">
    <DisplayString>{{ size={count} }}</DisplayString>

    <Expand>
      <Item Name="[size]">count</Item>

      <LinkedListItems>
        <Size>count</Size>
        <HeadPointer>head</HeadPointer>
        <NextPointer>($T1 *)next</NextPointer>
        <ValueNode>this</ValueNode>
      </LinkedListItems>
    </Expand>
  </Type>

  <!-- BEGIN GENERATED NODE VISUALIZERS (src/gen_natvis.py) -->
  <!-- Node shows the fields of its derived type based on kind.
       Inheritable="false" so the derived types don't pick this up and recurse. -->
  <Type Name="Node" Inheritable="false">
    <DisplayString>{kind,en}</DisplayString>

    <Expand>
      <ExpandedItem Condition="kind == NodeKind_Binary">*(BinaryNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Assign">*(AssignNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_VarDecl">*(VarDeclNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Var">*(VarNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Int64Literal">*(Int64LiteralNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Float32Literal">*(Float32LiteralNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Float64Literal">*(Float64LiteralNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Block">*(BlockNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_If">*(IfNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_While">*(WhileNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Print">*(PrintNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Param">*(ParamNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_ProcDecl">*(ProcDeclNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Call">*(CallNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Return">*(ReturnNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_BoolLiteral">*(BoolLiteralNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_AddressOf">*(AddressOfNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Deref">*(DerefNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_StructFieldDecl">*(StructFieldDeclNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_StructDecl">*(StructDeclNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_FieldAccess">*(FieldAccessNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Subscript">*(SubscriptNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_String">*(StringNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_CString">*(CStringNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Unary">*(UnaryNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Asm">*(AsmNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_EnumeratorDecl">*(EnumeratorDeclNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_EnumDecl">*(EnumDeclNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Cast">*(CastNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_ConstantDecl">*(ConstantDeclNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Yield">*(YieldNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Break">*(BreakNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Continue">*(ContinueNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_For">*(ForNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Defer">*(DeferNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Case">*(CaseNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Switch">*(SwitchNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_NullLiteral">*(NullLiteralNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Sizeof">*(SizeofNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_MacroDecl">*(MacroDeclNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_ProcRef">*(ProcRefNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_MacroRef">*(MacroRefNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Proxy">*(ProxyNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_RangeBasedFor">*(RangeBasedForNode *)this</ExpandedItem>
      <ExpandedItem Condition="kind == NodeKind_Foreach">*(ForeachNode *)this</ExpandedItem>
    </Expand>
  </Type>

  <Type Name="BinaryNode">
    <DisplayString>{kind,en}</DisplayString>

    <Expand>
      <Item Name="op">op</Item>
      <Item Name="lhs">lhs</Item>
      <Item Name="rhs">rhs</Item>
      <Item Name="[Node]">*(Node *)this,!</Item>
    </Expand>
  </Type>

  <Type Name="AssignNode">
    <DisplayString>{kind,en}</DisplayString>

    <Expand>
      <Item Name="lhs">lhs</Item>
      <Item Name="rhs">rhs</Item>
      <Item Name="[Node]">*(Node *)this,!</Item>
    </Expand>
  </Type>

  <Type Name="VarDeclNode">
    <DisplayString>{kind,en}</DisplayString>

    <Expand>
      <Item Name="name">name</Item>
      <Item Name="stackOffset">stackOffset</Item>
      <Item Name="expr">expr</Item>
      <Item Name="type">type</Item>
      <Item Name="[Node]">*(Node *)this,!</Item>
    </Expand>
  </Type>

  <Type Name="VarNode">
    <DisplayString>{kind,en}</DisplayString>

    <Expand>
      <Item Name="name">name</Item>
      <Item Name="stackOffset">stackOffset</Item>
      <Item Name="isGlobal">isGlobal</Item>
      <Item Name="[Node]">*(Node *)this,!</Item>
    </Expand>
  </Type>

  <Type Name="Int64LiteralNode">
    <DisplayString>{kind,en}</DisplayString>

    <Expand>
      <Item Name="value">value</Item>
      <Item Name="[Node]">*(Node *)this,!</Item>
    </Expand>
  </Type>

  <Type Name="Float32LiteralNode">
    <DisplayString>{kind,en}</DisplayString>

    <Expand>
      <Item Name="value">value</Item>
      <Item Name="[Node]">*(Node *)this,!</Item>
    </Expand>
  </Type>

  <Type Name="Float64LiteralNode">
    <DisplayString>{kind,en}</DisplayString>

    <Expand>
      <Item Name="value">value</Item>
      <Item Name="[Node]">*(Node *)this,!</Item>
    </Expand>
  </Type>

  <Type Name="BlockNode">
    <DisplayString>{kind,en}</DisplayString>

    <Expand>
      <Item Name="statements">statements</Item>
      <Item Name="stackSize">stackSize</Item>
      <Item Name="[Node]">*(Node *)this,!</Item>
    </Expand>
  </Type>

  <Type Name="IfNode">
    <DisplayString>{kind,en}</DisplayString>

    <Expand>
      <Item Name="condition">condition</Item>
      <Item Name="thenBlock">thenBlock</Item>
      <Item Name="elseBlock">elseBlock</Item>
      <Item Name="[Node]">*(Node *)this,!</Item>
    </Expand>
  </Type>

  <Type Name="WhileNode">
    <DisplayString>{kind,en}</DisplayString>

    <Expand>
