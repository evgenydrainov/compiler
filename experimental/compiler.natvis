      <Item Name="returnSlotOffset">returnSlotOffset</Item>
      <Item Name="calleeSlotOffset">calleeSlotOffset</Item>
      <Item Name="[Node]">*(Node *)this,!</Item>
    </Expand>
  </Type>

  <Type Name="ReturnNode">
