  </Type>

  <Type Name="ProcDeclNode">
    <DisplayString>{kind,en}</DisplayString>

    <Expand>
      <Item Name="name">name</Item>
      <Item Name="linkName">linkName</Item>
      <Item Name="body">body</Item>
      <Item Name="returnType">returnType</Item>
      <Item Name="params">params</Item>
      <Item Name="yieldIndex">yieldIndex</Item>
      <Item Name="isForeign">isForeign</Item>
      <Item Name="isCoroutine">isCoroutine</Item>
      <Item Name="isVariadic">isVariadic</Item>
