Title :: struct
{
};

title_update :: proc(title: *Title,
					 game: *Game)
{
	if is_confirm_pressed()
	{
		game.state = .world;
		world_init(&game.world);
	}
	else if IsKeyPressed(.L)
	{
		game.state = .leaderboard;
	}
}

title_draw :: proc(title: *Title,
				   game: *Game)
{
	x := GAME_WIDTH*0.5;
	y := 50.0;

	draw_text_centered2("BREAKOUT", x, y, 2);
	y += 40;

	draw_text_centered2("PRESS ENTER TO START", x, y, 2);
	y += 50;

	draw_text_centered1("ARROWS - MOVE", x, y, 1, color_from_u32(0xa0a0a0ff));
	y += 15;
	draw_text_centered1("SPACE - LAUNCH", x, y, 1, color_from_u32(0xa0a0a0ff));
	y += 15;
	draw_text_centered1("P - PAUSE", x, y, 1, color_from_u32(0xa0a0a0ff));
	y += 15;
	draw_text_centered2("L - LEADERBOARD", x, y, 1);
	y += 15;
}
