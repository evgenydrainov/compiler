//------------------------------------------------------------------------------------
// Window and Graphics Device Functions (Module: core)
//------------------------------------------------------------------------------------

// Window-related functions
InitWindow               :: proc(width: i32, height: i32, title: *u8) #foreign; // Initialize window and OpenGL context
CloseWindow              :: proc()                                    #foreign; // Close window and unload OpenGL context
WindowShouldClose        :: proc() -> bool                            #foreign; // Check if application should close (KEY_ESCAPE pressed or windows close icon clicked)
IsWindowReady            :: proc() -> bool                            #foreign; // Check if window has been initialized successfully
IsWindowFullscreen       :: proc() -> bool                            #foreign; // Check if window is currently fullscreen
IsWindowHidden           :: proc() -> bool                            #foreign; // Check if window is currently hidden
IsWindowMinimized        :: proc() -> bool                            #foreign; // Check if window is currently minimized
IsWindowMaximized        :: proc() -> bool                            #foreign; // Check if window is currently maximized
IsWindowFocused          :: proc() -> bool                            #foreign; // Check if window is currently focused
IsWindowResized          :: proc() -> bool                            #foreign; // Check if window has been resized last frame
IsWindowState            :: proc(flag: ConfigFlags) -> bool           #foreign; // Check if one specific window flag is enabled
SetWindowState           :: proc(flags: ConfigFlags)                  #foreign; // Set window configuration state using flags
ClearWindowState         :: proc(flags: ConfigFlags)                  #foreign; // Clear window configuration state flags
ToggleFullscreen         :: proc()                                    #foreign; // Toggle window state: fullscreen/windowed, resizes monitor to match window resolution
ToggleBorderlessWindowed :: proc()                                    #foreign; // Toggle window state: borderless windowed, resizes window to match monitor resolution
MaximizeWindow           :: proc()                                    #foreign; // Set window state: maximized, if resizable
MinimizeWindow           :: proc()                                    #foreign; // Set window state: minimized, if resizable
RestoreWindow            :: proc()                                    #foreign; // Restore window from being minimized/maximized
GetScreenWidth           :: proc() -> i32                             #foreign; // Get current screen width
GetScreenHeight          :: proc() -> i32                             #foreign; // Get current screen height

// Drawing-related functions
ClearBackground :: proc(color: Color)      #foreign; // Set background color (framebuffer clear color)
BeginDrawing    :: proc()                  #foreign; // Setup canvas (framebuffer) to start drawing
EndDrawing      :: proc()                  #foreign; // End canvas drawing and swap buffers (double buffering)
BeginMode2D     :: proc(camera: Camera2D)  #foreign; // Begin 2D mode with custom camera (2D)
EndMode2D       :: proc()                  #foreign; // Ends 2D mode with custom camera

// Timing-related functions
SetTargetFPS :: proc(fps: i32) #foreign; // Set target FPS (maximum)
GetFrameTime :: proc() -> f32  #foreign; // Get time in seconds for last frame drawn (delta time)
GetTime      :: proc() -> f64  #foreign; // Get elapsed time in seconds since InitWindow()
GetFPS       :: proc() -> i32  #foreign; // Get current FPS

// Misc. functions
SetConfigFlags :: proc(flags: ConfigFlags) #foreign; // Setup init configuration flags (view FLAGS)

// File system management functions
LoadFileData   :: proc(fileName: *u8, dataSize: *i32) -> *u8              #foreign; // Load file data as byte array (read)
UnloadFileData :: proc(data: *u8)                                         #foreign; // Unload file data allocated by LoadFileData()
SaveFileData   :: proc(fileName: *u8, data: *void, dataSize: i32) -> bool #foreign; // Save data to file from byte array (write), returns true on success

//------------------------------------------------------------------------------------
// Input Handling Functions (Module: core)
//------------------------------------------------------------------------------------

// Input-related functions: keyboard
IsKeyPressed       :: proc(key: KeyboardKey) -> bool #foreign; // Check if a key has been pressed once
IsKeyPressedRepeat :: proc(key: KeyboardKey) -> bool #foreign; // Check if a key has been pressed again
IsKeyDown          :: proc(key: KeyboardKey) -> bool #foreign; // Check if a key is being pressed
IsKeyReleased      :: proc(key: KeyboardKey) -> bool #foreign; // Check if a key has been released once
IsKeyUp            :: proc(key: KeyboardKey) -> bool #foreign; // Check if a key is NOT being pressed
GetCharPressed     :: proc() -> i32                  #foreign; // Get char pressed (unicode), call it multiple times for chars queued, returns 0 when the queue is empty
SetExitKey         :: proc(key: KeyboardKey)         #foreign; // Set a custom key to exit program (default is ESC)

// Input-related functions: mouse
GetMouseX :: proc() -> i32 #foreign; // Get mouse position X
GetMouseY :: proc() -> i32 #foreign; // Get mouse position Y

// Basic shapes drawing functions
DrawPixel     :: proc(posX: i32, posY: i32, color: Color)                          #foreign; // Draw a pixel using geometry [Can be slow, use with care]
DrawRectangle :: proc(posX: i32, posY: i32, width: i32, height: i32, color: Color) #foreign; // Draw a color-filled rectangle

//------------------------------------------------------------------------------------
// Texture Loading and Drawing Functions (Module: textures)
//------------------------------------------------------------------------------------

// Image loading functions
// NOTE: These functions do not require GPU access
LoadImageFromMemory :: proc(fileType: *u8, fileData: *u8, dataSize: i32) -> Image #foreign; // Load image from memory buffer, fileType refers to extension: i.e. '.png'
UnloadImage         :: proc(image: Image)                                         #foreign; // Unload image from CPU memory (RAM)

// Texture loading functions
// NOTE: These functions require GPU access
LoadTexture :: proc(fileName: *u8) -> Texture #foreign; // Load texture from file into GPU memory (VRAM)

// Texture drawing functions
DrawTexture    :: proc(texture: Texture, posX: i32, posY: i32, tint: i64)                 #foreign; // Draw a Texture2D
DrawTextureRec :: proc(texture: Texture, source: Rectangle, position: Vector2, tint: i64) #foreign; // Draw a part of a texture defined by a rectangle

// Color/pixel related functions
ColorNormalize      :: proc(color: Color)        -> Vector4 #foreign; // Get Color normalized as float [0..1]
ColorFromNormalized :: proc(normalized: Vector4) -> Color   #foreign; // Get Color from normalized values [0..1]
GetColor            :: proc(hexValue: u32)       -> Color   #foreign; // Get Color structure from hexadecimal value

//------------------------------------------------------------------------------------
// Font Loading and Text Drawing Functions (Module: text)
//------------------------------------------------------------------------------------

// Font loading/unloading functions
LoadFont          :: proc(fileName: *u8)                            -> Font #foreign; // Load font from file into GPU memory (VRAM)
LoadFontFromImage :: proc(image: Image, key: Color, firstChar: i32) -> Font #foreign; // Load font from Image (XNA style)

// Text drawing functions
DrawFPS    :: proc(posX: i32, posY: i32)                                                               #foreign; // Draw current FPS
DrawText   :: proc(text: *u8, posX: i32, posY: i32, fontSize: i32, color: Color)                       #foreign; // Draw text (using default font)
DrawTextEx :: proc(font: Font, text: *u8, position: Vector2, fontSize: f32, spacing: f32, tint: Color) #foreign; // Draw text using font and additional parameters

// Text font info functions
MeasureText   :: proc(text: *u8, fontSize: i32)                           -> i32     #foreign; // Measure string width for default font
MeasureTextEx :: proc(font: Font, text: *u8, fontSize: f32, spacing: f32) -> Vector2 #foreign; // Measure string size for Font

// Text strings management functions (no UTF-8 strings, only byte chars)
// WARNING 1: Most of these functions use internal static buffers[], it's recommended to store returned data on user-side for re-use
// WARNING 2: Some functions allocate memory internally for the returned strings, those strings must be freed by user using MemFree()
TextFormat :: proc(text: *u8) -> *u8 #foreign #variadic; // Text formatting with variables (sprintf() style)

Vector2 :: proc(x: f32, y: f32) -> Vector2
{
    result: Vector2 = ---;
    result.x = x;
    result.y = y;
    return result;
}

Vector3 :: proc(x: f32, y: f32, z: f32) -> Vector3
{
    result: Vector3 = ---;
    result.x = x;
    result.y = y;
    result.z = z;
    return result;
}

Vector4 :: proc(x: f32, y: f32, z: f32, w: f32) -> Vector4
{
    result: Vector4 = ---;
    result.x = x;
    result.y = y;
    result.z = z;
    result.w = w;
    return result;
}

Color :: proc(r: u8, g: u8, b: u8, a: u8) -> Color
{
    result: Color = ---;
    result.r = r;
    result.g = g;
    result.b = b;
    result.a = a;
    return result;
}

LoadImageFontFromMemory :: proc(fileType: *u8, fileData: *u8, dataSize: int) -> Font
{
	image := LoadImageFromMemory(fileType, fileData, cast(i32)dataSize);
	font := LoadFontFromImage(image, Color(255,0,255,255), 32);
	UnloadImage(image);
	return font;
}

IsWindowBorderlessFullscreen :: proc() -> bool
{
    return (IsWindowState(.BORDERLESS_WINDOWED_MODE)
            && IsWindowState(.WINDOW_UNDECORATED));
}
