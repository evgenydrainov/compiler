<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  
  <Type Name="string">
    <DisplayString>{data,[count]} [size={count}]</DisplayString>
    
    <Expand>
      <Item Name="[size]">count</Item>
      <Item Name="[string]">data,[count]s8</Item>
    </Expand>
  </Type>
  
  <Type Name="BumpArray&lt;*&gt;">
    <DisplayString>{{ size={count} }}</DisplayString>
    
    <Expand>
      <Item Name="[size]">count</Item>
      <Item Name="[capacity]">capacity</Item>
      
      <ArrayItems>
        <Size>count</Size>
        <ValuePointer>data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="StaticBumpArray&lt;*,*&gt;">
    <DisplayString>{{ size={count} }}</DisplayString>
    
    <Expand>
      <Item Name="[size]">count</Item>
      <Item Name="[capacity]">$T2</Item>
      
      <ArrayItems>
        <Size>count</Size>
        <ValuePointer>data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

</AutoVisualizer>
